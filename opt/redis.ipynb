    "import redis\n",
    "\n",
    "# 创建 Redis 连接\n",
    "r = redis.Redis(host='localhost', port=6379,password='QuantumGalaxy')\n",
    "\n",
    "# 获取已加载的模块列表\n",
    "modules = r.execute_command('MODULE', 'LIST')\n",
    "\n",
    "# 打印模块列表\n",
    "for module_info in modules:\n",
    "    print(module_info)"
   ]
